{
  "name": "markmaid",
  "private": true,
  "version": "0.1.8",
  "description": "A focused, read-only Markdown reader for macOS",
  "author": "Walt Wang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weichen-LF/Markmaid.git"
  },
  "bugs": {
    "url": "https://github.com/Weichen-LF/Markmaid/issues"
  },
  "homepage": "https://github.com/Weichen-LF/Markmaid#readme",
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "./scripts/check.sh",
    "ipc:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings --",
    "ipc:check": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin export-bindings -- --check",
    "icons:generate": "./scripts/generate-icons.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf:fixtures": "node scripts/performance/generate-fixtures.mjs",
    "perf:smoke": "node scripts/performance/generate-fixtures.mjs && vitest run --config performance/vitest.smoke.config.ts",
    "perf:baseline": "node scripts/performance/run-baseline.mjs",
    "preview": "vite preview",
    "release:prepare": "./scripts/prepare-release.sh",
    "release:build": "./scripts/build-release.sh",
    "release:publish": "./scripts/publish-release.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "katex": "0.18.1",
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4"
  }
}
